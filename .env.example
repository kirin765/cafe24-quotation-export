# Cafe24 앱 등록 정보 (개발자센터 > 앱 기본정보)
CAFE24_CLIENT_ID=
CAFE24_CLIENT_SECRET=
# 개발자센터에 등록한 Redirect URI와 글자 단위로 같아야 한다.
CAFE24_REDIRECT_URI=https://cafe24-quotation-export.vercel.app/api/auth/callback
# 요청 scope. 등록한 권한관리 항목과 일치해야 한다. 비우면 mall.read_product.
CAFE24_SCOPES=mall.read_product
# 고정할 Admin API 버전. 유효기간 1년이라 만료 전에 올린다.
CAFE24_API_VERSION=2026-09-01
# 개발자센터의 WebHook 인증정보 값 그대로. 이 값이 X-API-Key 헤더와 같아야 웹훅을 처리한다.
CAFE24_WEBHOOK_API_KEY=

# 토큰 저장용 Postgres. 비우면 메모리(로컬 개발 전용, 서버리스에서 유실됨).
DATABASE_URL=
